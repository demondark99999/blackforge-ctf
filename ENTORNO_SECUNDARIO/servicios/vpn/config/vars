# Variables para Easy-RSA - BlackForge Labs
# Estas variables se utilizan para generar certificados para el servidor VPN

set_var EASYRSA_REQ_COUNTRY    "US"
set_var EASYRSA_REQ_PROVINCE   "California"
set_var EASYRSA_REQ_CITY       "San Francisco"
set_var EASYRSA_REQ_ORG        "BlackForge Labs"
set_var EASYRSA_REQ_EMAIL      "admin@forgelabs.local"
set_var EASYRSA_REQ_OU         "IT Security"

# Valores de dificultad y tiempo de validez
set_var EASYRSA_KEY_SIZE       2048
set_var EASYRSA_CA_EXPIRE      3650
set_var EASYRSA_CERT_EXPIRE    825

# Algoritmo de firma predeterminado
set_var EASYRSA_DIGEST         "sha256"